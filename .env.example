# ==========================================
# ÁLBUM DE PATENTES - CONFIGURACIÓN LOCAL
# ==========================================

# Base de Datos (PostgreSQL local en Docker)
POSTGRES_USER=patentes_user
POSTGRES_PASSWORD=patentes_pass_secret
POSTGRES_DB=patentes_db
POSTGRES_PORT=5432
DATABASE_URL=postgresql://patentes_user:patentes_pass_secret@postgres:5432/patentes_db?schema=public

# Backend API Service
PORT=4000
NODE_ENV=development
JWT_SECRET=super_secret_jwt_key_patentes_2026_change_me
FRONTEND_URL=http://localhost:3000

# Cloudinary (Almacenamiento Gratuito de Imágenes en Producción)
CLOUDINARY_CLOUD_NAME=demo
CLOUDINARY_API_KEY=123456789
CLOUDINARY_API_SECRET=abcdefghijklmnopqrstuvwxyz

# Frontend App Config
NEXT_PUBLIC_API_URL=http://localhost:4000/api
NEXT_PUBLIC_DEFAULT_LOCALE=es

# Google OAuth
NEXT_PUBLIC_GOOGLE_CLIENT_ID=your_google_client_id_here.apps.googleusercontent.com
GOOGLE_CLIENT_ID=your_google_client_id_here.apps.googleusercontent.com

# Facebook OAuth
NEXT_PUBLIC_FACEBOOK_CLIENT_ID=your_facebook_app_id_here
FACEBOOK_CLIENT_SECRET=your_facebook_app_secret_here

# GitHub OAuth
NEXT_PUBLIC_GITHUB_CLIENT_ID=your_github_client_id_here
GITHUB_CLIENT_SECRET=your_github_client_secret_here

# platerecognizer.com
PLATE_RECOGNIZER_TOKEN=123456