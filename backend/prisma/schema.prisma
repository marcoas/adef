// -------------------------------------------------------------
// Esquema Prisma DB: Álbum de Patentes
// Compatible con PostgreSQL (Local Docker, Supabase, Neon)
// -------------------------------------------------------------

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  OWNER
  ASSOCIATE
}

// Issue #33: acción registrada en el log histórico de movimientos del álbum
enum StickerAction {
  PASTE
  UNPASTE
}

// Issue #34 + #37: tipos de aviso que puede recibir un usuario
enum NotificationType {
  STICKER_PASTED
  ASSOCIATE_JOINED
  ASSOCIATE_LEFT
  ACCESS_REVOKED
}

// Issue #41: estado de la cuenta. RESTRICTED = el admin bloqueó el acceso:
// el usuario no puede iniciar sesión ni usar ninguna ruta autenticada.
enum UserStatus {
  ACTIVE
  RESTRICTED
}

model User {
  id            String         @id @default(uuid())
  email         String         @unique
  name          String
  avatarUrl     String?        @map("avatar_url")
  authProvider  String         @default("google") @map("auth_provider")
  // Issue #34: preferencia configurable desde el panel de usuario
  notifyOnAlbumActivity Boolean  @default(true) @map("notify_on_album_activity")
  // Issue #41: rol de administración (panel privado de administración)
  isAdmin       Boolean      @default(false) @map("is_admin")
  // Issue #41: estado de la cuenta (ACTIVE / RESTRICTED por un admin)
  status        UserStatus   @default(ACTIVE)
  // Issue #41: último login exitoso, para el dashboard de uso
  lastLoginAt   DateTime?    @map("last_login_at")
  createdAt     DateTime       @default(now()) @map("created_at")
  updatedAt     DateTime       @updatedAt @map("updated_at")

  ownedAlbums   Album[]        @relation("AlbumOwner")
  memberships   AlbumMember[]
  stickers      Sticker[]
  createdInvites AlbumInvite[] @relation("InviteCreator")
  usedInvites    AlbumInvite[] @relation("InviteRedeemer")
  // Issue #33 / #34
  activities             StickerActivity[]
  notifications          Notification[]      @relation("NotificationRecipient")
  triggeredNotifications Notification[]      @relation("NotificationActor")

  @@map("users")
}

model Album {
  id          String        @id @default(uuid())
  title       String        @default("Mi Álbum de Patentes")
  ownerId     String        @map("owner_id")
  createdAt   DateTime      @default(now()) @map("created_at")

  owner       User          @relation("AlbumOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  members     AlbumMember[]
  stickers    Sticker[]
  invites     AlbumInvite[]
  // Issue #33 / #34
  activities    StickerActivity[]
  notifications Notification[]

  @@map("albums")
}

model AlbumMember {
  id        String   @id @default(uuid())
  albumId   String   @map("album_id")
  userId    String   @map("user_id")
  role      Role     @default(ASSOCIATE)
  joinedAt  DateTime @default(now()) @map("joined_at")

  album     Album    @relation(fields: [albumId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([albumId, userId])
  @@map("album_members")
}

// Issue #12: links de invitación de un solo uso por álbum
model AlbumInvite {
  id          String    @id @default(uuid())
  token       String    @unique
  albumId     String    @map("album_id")
  createdById String    @map("created_by_id")
  expiresAt   DateTime  @map("expires_at")
  usedAt      DateTime? @map("used_at")
  usedById    String?   @map("used_by_id")
  createdAt   DateTime  @default(now()) @map("created_at")

  album     Album @relation(fields: [albumId], references: [id], onDelete: Cascade)
  createdBy User  @relation("InviteCreator", fields: [createdById], references: [id], onDelete: Cascade)
  usedBy    User? @relation("InviteRedeemer", fields: [usedById], references: [id], onDelete: SetNull)

  @@index([albumId])
  @@map("album_invites")
}

model Sticker {
  id               String   @id @default(uuid())
  albumId          String   @map("album_id")
  slotNumber       Int      @map("slot_number") // Casillero 0 al 999
  rawPlate         String   @map("raw_plate")   // Formato leído (ej: AB 123 CD)
  imageUrl         String   @map("image_url")   // URL en disco local, Cloudinary o remota
  thumbnailUrl     String?  @map("thumbnail_url") // Issue #11: miniatura liviana para la grilla
  uploadedByUserId String   @map("uploaded_by_user_id")
  capturedAt       DateTime @default(now()) @map("captured_at")

  album            Album    @relation(fields: [albumId], references: [id], onDelete: Cascade)
  uploadedBy       User     @relation(fields: [uploadedByUserId], references: [id], onDelete: Cascade)

  @@unique([albumId, slotNumber])
  @@map("stickers")
}

// Issue #33: log histórico y cronológico de movimientos del álbum.
// Se guarda `userName` como snapshot para que el log sobreviva aunque el
// usuario se elimine (userId queda en null vía onDelete: SetNull).
model StickerActivity {
  id         String        @id @default(uuid())
  albumId    String        @map("album_id")
  userId     String?       @map("user_id")
  userName   String        @map("user_name")
  slotNumber Int           @map("slot_number")
  rawPlate   String        @map("raw_plate")
  action     StickerAction
  createdAt  DateTime      @default(now()) @map("created_at")

  album Album @relation(fields: [albumId], references: [id], onDelete: Cascade)
  user  User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([albumId, createdAt])
  @@map("sticker_activities")
}

// Issue #34: avisos para el dueño del álbum cuando un asociado pega una
// figurita o se suma al álbum. Se guarda `actorName` como snapshot.
model Notification {
  id          String           @id @default(uuid())
  userId      String           @map("user_id")
  albumId     String           @map("album_id")
  actorUserId String?          @map("actor_user_id")
  actorName   String           @map("actor_name")
  type        NotificationType @default(STICKER_PASTED)
  slotNumber  Int?             @map("slot_number")
  rawPlate    String?          @map("raw_plate")
  message     String
  readAt      DateTime?        @map("read_at")
  createdAt   DateTime         @default(now()) @map("created_at")

  user  User  @relation("NotificationRecipient", fields: [userId], references: [id], onDelete: Cascade)
  album Album @relation(fields: [albumId], references: [id], onDelete: Cascade)
  actor User? @relation("NotificationActor", fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([albumId])
  @@map("notifications")
}

// Issue #48: registro de cada llamada a una API externa (Plate Recognizer).
// Almacena el consumo real para el panel de administración: total del mes,
// cuota mensual, restante y porcentaje. Se guarda `ok` para distinguir
// llamadas exitosas de fallidas (ambas consumen cuota del proveedor).
model ExternalApiCall {
  id        String   @id @default(uuid())
  provider  String   @default("plate_recognizer")
  ok        Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at")

  @@index([provider, createdAt])
  @@map("external_api_calls")
}
